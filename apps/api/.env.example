# Application Settings
ENVIRONMENT=development
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Document Processing Settings
MAX_UPLOAD_SIZE_MB=50
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=200

# Supabase (Auth, PostgreSQL, Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / LLM (Gemini 3.1 Pro Preview)
GEMINI_API_KEY=

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=patent_prior_art
QDRANT_STORAGE_PATH=

# Sparse Lexical Retrieval (BM25)
BM25_K1=1.5
BM25_B=0.75
DEFAULT_RETRIEVAL_TOP_K=10

# Dense Semantic Retrieval (BGE)
BGE_MODEL_NAME=BAAI/bge-base-en-v1.5
BGE_NORMALIZE_EMBEDDINGS=true

# Reciprocal Rank Fusion (RRF)
RRF_K=60
RRF_CANDIDATE_DEPTH=20

# BGE Cross-Encoder Reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=8
RERANKER_CANDIDATE_DEPTH=20

# Feature-to-Evidence Mapping
MAPPING_LEXICAL_WEIGHT=0.4
MAPPING_SEMANTIC_WEIGHT=0.6
MAPPING_TOP_K=5
DIRECT_MATCH_THRESHOLD=0.75
PARTIAL_MATCH_THRESHOLD=0.50
CONTEXTUAL_MATCH_THRESHOLD=0.30
WEAK_MATCH_THRESHOLD=0.15

# Evidence-Based Patent Readiness Engine (EB-PRE)
READINESS_WEIGHT_NOVELTY=0.30
READINESS_WEIGHT_PRIOR_ART_OVERLAP=0.20
READINESS_WEIGHT_TECH_DIFFERENTIATION=0.20
READINESS_WEIGHT_INNOVATION_CHARS=0.15
READINESS_WEIGHT_DOC_QUALITY=0.10
READINESS_WEIGHT_COMMERCIAL_POTENTIAL=0.05
READINESS_THRESHOLD_MODERATE=0.40
READINESS_THRESHOLD_HIGH=0.70

# Grounded Gemini Explanation & Reporting
GEMINI_API_KEY=
GEMINI_EXPLANATION_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_SECONDS=30.0
EXPLANATION_MAX_EVIDENCE_ITEMS=15

